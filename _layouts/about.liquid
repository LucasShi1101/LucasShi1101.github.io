---
layout: default
---
<div class="home-page">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <p class="home-eyebrow">AI interpretability · Sydney & Singapore</p>
      <h1 id="home-title">Chuancheng <span>Shi</span></h1>
      <p class="home-hero__statement">Understanding how foundation models work, <span class="gradient-text"><span class="gradient-text__inner"><span class="gradient-text__content">from the inside.</span></span></span></p>
      <p class="home-hero__lead">Researcher at the University of Sydney and Research Intern at the NExT++ Center. I study the knowledge, representations, and information pathways inside modern AI.</p>
      <div class="home-actions">
        <a class="home-button home-button--primary" href="{{ '/publications/' | relative_url }}">Explore research <span aria-hidden="true">↗</span></a>
        <a class="home-button home-button--secondary" href="{{ '/blog/' | relative_url }}">Read the blog <span aria-hidden="true">↗</span></a>
      </div>
      <a class="home-contact-link" href="mailto:chuancheng1101@gmail.com">Email Chuancheng <span aria-hidden="true">↗</span></a>
    </div>
    <div class="home-hero__visual">
      <div class="home-hero__orbit" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="home-hero__photo-frame">
        <img src="{{ '/assets/img/profile-home.webp' | relative_url }}" alt="Three cats resting together" loading="eager" fetchpriority="high" width="900" height="900">
      </div>
      <div class="home-hero__note"><span class="home-hero__note-dot" aria-hidden="true"></span> Researching transparent and reliable AI</div>
    </div>
  </section>

  <div class="home-content">{{ content }}</div>

  {% if page.announcements and page.announcements.enabled %}
    <section class="home-section home-news" aria-labelledby="home-news-title">
      <div class="home-section__heading"><div><p class="home-section__index">01 / Updates</p><h2 id="home-news-title">Research news</h2></div><a class="home-section__link" href="{{ '/news/' | relative_url }}">All updates <span aria-hidden="true">↗</span></a></div>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="home-section home-papers" aria-labelledby="home-papers-title">
      <div class="home-section__heading"><div><p class="home-section__index">02 / Publications</p><h2 id="home-papers-title">Representative works</h2></div><a class="home-section__link" href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">↗</span></a></div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  {% if site.posts.size > 0 %}
    {% assign recent_posts = site.posts | sort: 'date' | reverse %}
    <section class="home-section home-journal" aria-labelledby="home-journal-title">
      <div class="home-section__heading"><div><p class="home-section__index">03 / Writing</p><h2 id="home-journal-title">From the blog</h2></div><a class="home-section__link" href="{{ '/blog/' | relative_url }}">All articles <span aria-hidden="true">↗</span></a></div>
      <div class="home-journal__grid">
        {% for post in recent_posts limit: 3 %}
          <a class="home-journal__card theme-{{ post.design_theme }}" href="{{ post.url | relative_url }}"><span class="home-journal__date">{{ post.date | date: '%b %d, %Y' }}</span><h3>{{ post.title }}</h3><p>{{ post.description }}</p><span class="home-journal__arrow" aria-hidden="true">↗</span></a>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <section class="home-closing" aria-labelledby="home-closing-title"><p>Research is a conversation.</p><h2 id="home-closing-title">Let's make AI easier to understand.</h2><a class="home-button home-button--light" href="mailto:chuancheng1101@gmail.com">Get in touch <span aria-hidden="true">↗</span></a>{% if page.social %}<div class="social"><div class="contact-icons">{% include social.liquid %}</div></div>{% endif %}</section>
</div>
<script defer src="{{ '/assets/js/home-motion.js' | relative_url | bust_file_cache }}"></script>
